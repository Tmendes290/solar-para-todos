# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# package.json na raiz é só ferramenta local (Playwright pra gerar PDF).
# Não pode ir pro repo: o Railway detecta esse arquivo na raiz e tenta
# buildar como app Node em vez de servir o site como estático.
/package.json
/package-lock.json

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md
